# Terraform
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.backup

# Terragrunt
**/.terragrunt-cache/
**/.terragrunt-stack/

# ALZ provider cache
.alzlib/

# Generated by Terragrunt at runtime (root.hcl and per-unit generate blocks)
**/backend.tf
**/providers.tf
**/context.tf

# Local overrides
**/*.local.hcl
**/*.local.tfvars

# Editor
.vscode/
.idea/
.DS_Store

# Plan output and crash logs can hold secrets
**/*.tfplan
**/tfplan
**/*.plan
**/plan.out
**/plan.json
**/crash.log
**/crash.*.log

# Local overrides and credentials
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
.env
.env.*
**/*.pem
**/*.key
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example
