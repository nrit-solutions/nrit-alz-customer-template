# Terragrunt entries — append to your repo .gitignore

# Terragrunt's per-unit working cache
.terragrunt-cache/

# Generated Stacks output (never commit; regenerated by `terragrunt stack generate`)
.terragrunt-stack/

# Files generated by Terragrunt into units (regenerated each run).
# Match the names your root.hcl actually writes. Committing these means every
# later PR carries spurious diffs in files nobody edits, and providers.tf and
# context.tf both hold the resolved subscription and tenant ids.
**/backend.tf
**/providers.tf
**/context.tf

# ALZ provider library cache
.alzlib/

# OpenTofu / Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl   # commit this if you want locked provider versions; ignore if generated per-unit
crash.log
*.tfvars              # if they may contain secrets; otherwise commit non-secret ones
terragrunt-debug.tfvars.json

# SOPS — commit only the *.enc.* files, never the plaintext
secrets.dec.*
